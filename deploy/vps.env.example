SITE_ADDRESS=replate.example.com
MSSQL_PID=Express
MSSQL_SA_PASSWORD=replace-with-a-strong-database-admin-password
# Provision a dedicated application SQL login before starting the API.
DATABASE_URL=sqlserver://database:1433;database=Replate;user=replate_app;password=replace-app-password;encrypt=true;trustServerCertificate=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_SERVICE_KEY=replace-with-a-different-random-secret-at-least-32-characters
